<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF8F0"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thanh toán bằng QR"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#5D4037"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvQrAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số tiền: 0đ"
        android:textSize="16sp"
        android:textColor="#6D4C41"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/imgQr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:scaleType="fitCenter"
        android:background="#FFFFFF"
        android:padding="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đây là mã QR mô phỏng\n(Quét không mất tiền thật)"
        android:textSize="13sp"
        android:textColor="#8D6E63"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPaid"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Tôi đã thanh toán"
        android:textSize="15sp"
        app:cornerRadius="24dp"
        android:backgroundTint="#6D4C41"
        android:textColor="#FFFFFF" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelQr"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Hủy"
        android:textSize="14sp"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="#8D6E63"
        android:layout_marginTop="4dp" />

</LinearLayout>